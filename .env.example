# Melody Masters — environment variables
# ---------------------------------------------------------------------------
# EVERYTHING HERE IS OPTIONAL. With no .env file at all the app runs in
# local-first mode: lessons, instruments, tuner, practice history and settings
# are saved in your browser. Copy to .env.local and fill in only what you need.
#   cp .env.example .env.local
# Never commit real keys. None of these are exposed to the browser (no
# NEXT_PUBLIC_ prefix), and they are only read in server code.

# --- Public URL ------------------------------------------------------------
# Used for OAuth redirect URLs and same-origin checks behind a proxy.
# Defaults to the request origin (e.g. http://localhost:3000).
APP_URL=

# --- Optional account + cross-device sync (PostgreSQL) ----------------------
# Leave empty to stay local-only. When set, enables sign up / sign in and the
# "Account & sync" panel in Settings. Then run:  npm run db:migrate && npm run db:seed
# Example: postgresql://user:password@localhost:5432/melody_masters
DATABASE_URL=

# Not required: sessions use random 256-bit tokens stored hashed in the DB, so
# there is no signing secret. Reserved for future use.
# AUTH_SECRET=

# Optional "Continue with Google" (requires DATABASE_URL). Create an OAuth
# client (type: Web application) in Google Cloud Console and add the
# redirect URI  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional video search ----------------------------------------------------
# Not used by default (the Video Hub ships with a curated, verified list).
YOUTUBE_API_KEY=
